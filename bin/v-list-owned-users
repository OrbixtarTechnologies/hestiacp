#!/bin/bash
# info: list hosting accounts visible to an administrator or reseller
# options: USER [FORMAT]
#
# example: v-list-owned-users admin json

user=$1
format=${2-json}

source /etc/hestiacp/hestia.conf
source "$HESTIA/func/main.sh"
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user' 'format'
is_object_valid 'user' 'USER' "$user"

if [ "$user" = "$ROOT_USER" ]; then
	exec "$BIN/v-list-users" "$format"
fi

is_reseller_valid "$user"
exec "$BIN/v-list-reseller-users" "$user" "$format"
