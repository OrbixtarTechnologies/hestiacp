#!/bin/bash
# info: add an account owned by a least-privilege reseller
# options: RESELLER USER PASSWORD EMAIL PACKAGE [NAME]
#
# example: v-add-reseller-user agency client password client@example.com default 'Client Name'

reseller=$1
user=$2
password=$3
HIDE=3
email=$4
package=$5
name=$6

source /etc/hestiacp/hestia.conf
source "$HESTIA/func/main.sh"
source_conf "$HESTIA/conf/hestia.conf"

check_args '5' "$#" 'RESELLER USER PASSWORD EMAIL PACKAGE [NAME]'
is_user_format_valid "$reseller" 'reseller'
is_format_valid 'user' 'email' 'package'
if [ -n "$name" ]; then
	is_format_valid 'name'
fi
is_reseller_valid "$reseller"

reseller_conf="$HESTIA/data/users/$reseller/user.conf"
max_users=$(awk -F"'" '/^RESELLER_MAX_USERS=/ {print $2}' "$reseller_conf")
allowed_packages=$(awk -F"'" '/^RESELLER_PACKAGES=/ {print $2}' "$reseller_conf")
if [[ ",$allowed_packages," != *",$package,"* ]]; then
	check_result "$E_FORBIDEN" "package $package is not assigned to reseller $reseller"
fi

mkdir -p "$HESTIA/data/reseller-locks"
exec 9> "$HESTIA/data/reseller-locks/$reseller.lock"
if ! flock -n 9; then
	check_result "$E_INUSE" "another account operation is already running for reseller $reseller"
fi

owned_count=$(grep -l "^OWNER='$reseller'$" "$HESTIA"/data/users/*/user.conf 2> /dev/null | wc -l)
if [ "$owned_count" -ge "$max_users" ]; then
	check_result "$E_LIMIT" "reseller account limit is reached"
fi

check_hestia_demo_mode
$BIN/v-add-user "$user" "$password" "$email" "$package" "$name"
check_result "$?" "account creation failed"
update_user_value "$user" '$OWNER' "$reseller"
increase_user_value "$reseller" '$U_USERS'
$BIN/v-log-action "$reseller" "Info" "Users" "Managed account added (User: $user, Package: $package)."
log_event "$OK" "$ARGUMENTS"

exit
