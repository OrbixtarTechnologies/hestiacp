#!/bin/bash
# info: list tracked AutoSSL jobs for a hosting account
# options: USER [FORMAT]
#
# example: v-list-autossl-jobs admin json

user=$1
format=${2-shell}

source /etc/hestiacp/hestia.conf
source "$HESTIA/func/main.sh"
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user' 'format'
is_object_valid 'user' 'USER' "$user"

state_dir="/var/log/orbixpanel/autossl"
mkdir -p "$state_dir"
chmod 750 "$state_dir"

json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

mapfile -t jobs < <(
	find "$state_dir" -maxdepth 1 -type f -name '*.meta' -printf '%f\n' \
		| sed 's/\.meta$//' \
		| sort -r
)

read_job() {
	local job_id=$1
	local meta_file="$state_dir/$job_id.meta"
	JOB_ID=$(sed -n 's/^JOB_ID=//p' "$meta_file")
	JOB_USER=$(sed -n 's/^USER=//p' "$meta_file")
	DOMAINS=$(sed -n 's/^DOMAINS=//p' "$meta_file")
	TOTAL=$(sed -n 's/^TOTAL=//p' "$meta_file")
	STARTED=$(sed -n 's/^STARTED=//p' "$meta_file")
	STATUS=$(head -n 1 "$state_dir/$job_id.status" 2> /dev/null || echo unknown)
	PID=$(head -n 1 "$state_dir/$job_id.pid" 2> /dev/null || true)
	SUCCEEDED=$(grep -c '^success ' "$state_dir/$job_id.results" 2> /dev/null || true)
	FAILED=$(grep -c '^failed ' "$state_dir/$job_id.results" 2> /dev/null || true)
	PROCESSED=$((SUCCEEDED + FAILED))
	if [[ "$STATUS" == queued || "$STATUS" == running:* ]] && { [[ -z "$PID" ]] || ! kill -0 "$PID" 2> /dev/null; }; then
		STATUS="interrupted:$PROCESSED/${TOTAL:-0}"
		printf '%s\n' "$STATUS" > "$state_dir/$job_id.status"
	fi
}

owned_jobs=()
for job in "${jobs[@]}"; do
	read_job "$job"
	if [[ "$JOB_USER" == "$user" ]]; then
		owned_jobs+=("$job")
	fi
done

json_list() {
	echo '{'
	local index=0
	local total_jobs=${#owned_jobs[@]}
	local job
	for job in "${owned_jobs[@]:0:25}"; do
		read_job "$job"
		((index++))
		printf '\t"%s": {"STATUS": "%s", "DOMAINS": "%s", "TOTAL": "%s", "PROCESSED": "%s", "SUCCEEDED": "%s", "FAILED": "%s", "STARTED": "%s"}' \
			"$(json_escape "$JOB_ID")" "$(json_escape "$STATUS")" "$(json_escape "$DOMAINS")" \
			"$(json_escape "$TOTAL")" "$(json_escape "$PROCESSED")" "$(json_escape "$SUCCEEDED")" \
			"$(json_escape "$FAILED")" "$(json_escape "$STARTED")"
		if ((index < total_jobs && index < 25)); then
			echo ','
		else
			echo
		fi
	done
	echo '}'
}

plain_list() {
	local job
	for job in "${owned_jobs[@]:0:25}"; do
		read_job "$job"
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$JOB_ID" "$STATUS" "$TOTAL" "$PROCESSED" "$SUCCEEDED" "$FAILED" "$STARTED"
	done
}

case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) plain_list | column -t -s $'\t' ;;
	csv)
		echo 'JOB_ID,STATUS,TOTAL,PROCESSED,SUCCEEDED,FAILED,STARTED'
		plain_list | tr '\t' ','
		;;
esac

exit 0
