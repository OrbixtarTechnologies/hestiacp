#!/bin/bash
# info: validate and start a cPanel account migration
# options: BACKUP [RESTORE_MX]
#
# example: v-start-cpanel-import cpmove-example.tar.gz no

backup_name=$1
restore_mx=${2-no}

# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'BACKUP [RESTORE_MX]'
check_hestia_demo_mode

if [ "${#backup_name}" -gt 180 ] || [[ ! "$backup_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.(tar\.gz|tgz)$ ]]; then
	check_result "$E_INVALID" "Invalid cPanel backup filename"
fi
if [[ "$restore_mx" != "yes" && "$restore_mx" != "no" ]]; then
	check_result "$E_INVALID" "RESTORE_MX must be yes or no"
fi

archive="$BACKUP/$backup_name"
if [ ! -f "$archive" ] || [ -L "$archive" ]; then
	check_result "$E_NOTEXIST" "cPanel backup $backup_name does not exist"
fi

resolved_archive=$(realpath -e -- "$archive")
case "$resolved_archive" in
	"$BACKUP"/*) ;;
	*) check_result "$E_FORBIDEN" "Backup must be stored directly in $BACKUP" ;;
esac

state_dir="/var/log/orbixpanel/migrations"
mkdir -p "$state_dir"
chmod 750 "$state_dir"

job_id="$(date '+%Y%m%d%H%M%S')-$$-$RANDOM"
status_file="$state_dir/$job_id.status"
log_file="$state_dir/$job_id.log"
meta_file="$state_dir/$job_id.meta"
lock_file="$state_dir/$backup_name.lock"
started_at=$(date '+%FT%T%z')

printf 'queued\n' > "$status_file"
cat > "$meta_file" << EOF
JOB_ID=$job_id
BACKUP=$backup_name
RESTORE_MX=$restore_mx
STARTED=$started_at
EOF

nohup /bin/bash -c '
	status_file=$1
	lock_file=$2
	import_command=$3
	archive=$4
	restore_mx=$5
	exec 9>"$lock_file"
	if ! flock -n 9; then
		printf "failed:archive already has an active migration\n" > "$status_file"
		exit 1
	fi
	printf "validating\n" > "$status_file"
	archive_index=$(mktemp)
	trap '\''rm -f "$archive_index"'\'' EXIT
	if ! gzip -t -- "$archive"; then
		printf "failed:invalid gzip archive\n" > "$status_file"
		exit 2
	fi
	if ! tar -tzf "$archive" > "$archive_index"; then
		printf "failed:archive could not be inspected\n" > "$status_file"
		exit 2
	fi
	if grep -Eq '\''(^/|(^|/)\.\.(/|$)|[[:cntrl:]])'\'' "$archive_index"; then
		printf "failed:unsafe archive path\n" > "$status_file"
		exit 2
	fi
	if ! grep -Eq '\''(^|/)userdata/'\'' "$archive_index" || ! grep -Eq '\''(^|/)cp/'\'' "$archive_index"; then
		printf "failed:required cPanel account data is missing\n" > "$status_file"
		exit 2
	fi
	printf "running\n" > "$status_file"
	if "$import_command" "$archive" "$restore_mx"; then
		printf "completed\n" > "$status_file"
	else
		exit_code=$?
		printf "failed:exit code %s\n" "$exit_code" > "$status_file"
		exit "$exit_code"
	fi
' orbixpanel-migration "$status_file" "$lock_file" "$BIN/v-import-cpanel" "$resolved_archive" "$restore_mx" > "$log_file" 2>&1 < /dev/null &

job_pid=$!
printf '%s\n' "$job_pid" > "$state_dir/$job_id.pid"
chmod 640 "$status_file" "$log_file" "$meta_file" "$state_dir/$job_id.pid"

echo "$job_id"
exit
